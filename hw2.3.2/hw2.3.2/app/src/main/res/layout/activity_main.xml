<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_display_panel"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="CALCULATOR"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/btn_num_text"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:useDefaultMargins="false">

            <Button
                android:id="@+id/CButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_clear_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="C"
                android:textColor="@color/btn_clear_text"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/bracketsButtonButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_func_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="()"
                android:textColor="@color/btn_func_text"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/perCentButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_func_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="%"
                android:textColor="@color/btn_func_text"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/divButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_op_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="÷"
                android:textColor="@color/btn_op_text"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/sevenButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="7"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/eightButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="8"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/nineButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="9"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/mulButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_op_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="×"
                android:textColor="@color/btn_op_text"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/fourButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="4"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/fiveButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="5"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/sixButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="6"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/subButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_op_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="−"
                android:textColor="@color/btn_op_text"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/oneButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/twoButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="2"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/threeButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="3"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/addButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_op_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textColor="@color/btn_op_text"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/zeroButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="0"
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/dotButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_num_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="."
                android:textColor="@color/btn_num_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_func_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⌫"
                android:textColor="@color/btn_func_text"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/equalButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="@color/btn_eq_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="="
                android:textColor="@color/btn_eq_text"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
